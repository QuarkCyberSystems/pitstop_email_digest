			"tq-asset-register": {
				"name": "tq-asset-register",
				"title": "Asset Register",
				"workbook": "template-erpnext-asset",
				"folder": null,
				"sort_order": 0,
				"use_live_connection": 1,
				"is_script_query": 0,
				"is_builder_query": 1,
				"is_native_query": 0,
				"operations": [
					{
						"type": "source",
						"table": {
							"type": "table",
							"data_source": "Site DB",
							"table_name": "tabAsset"
						}
					},
					{
						"type": "filter_group",
						"logical_operator": "And",
						"filters": [
							{
								"column": {
									"type": "column",
									"column_name": "docstatus"
								},
								"operator": "=",
								"value": 1
							}
						]
					},
					{
						"type": "remove",
						"column_names": [
							"value_after_depreciation",
							"depreciation_method"
						]
					},
					{
						"type": "join",
						"join_type": "inner",
						"table": {
							"type": "table",
							"data_source": "Site DB",
							"table_name": "tabAsset Finance Book"
						},
						"select_columns": [
							{
								"type": "column",
								"column_name": "value_after_depreciation"
							},
							{
								"type": "column",
								"column_name": "rate_of_depreciation"
							},
							{
								"type": "column",
								"column_name": "depreciation_method"
							},
							{
								"type": "column",
								"column_name": "depreciation_start_date"
							}
						],
						"join_condition": {
							"left_column": {
								"type": "column",
								"column_name": "name"
							},
							"right_column": {
								"type": "column",
								"column_name": "parent"
							}
						}
					},
					{
						"type": "mutate",
						"new_name": "accumulated_depreciation",
						"data_type": "Decimal",
						"expression": {
							"type": "expression",
							"expression": "gross_purchase_amount - value_after_depreciation"
						}
					},
					{
						"type": "mutate",
						"new_name": "asset_age_days",
						"data_type": "Integer",
						"expression": {
							"type": "expression",
							"expression": "date_diff(today(), purchase_date, 'day')"
						}
					},
					{
						"type": "mutate",
						"new_name": "asset_age_years",
						"data_type": "Decimal",
						"expression": {
							"type": "expression",
							"expression": "asset_age_days / 365.0"
						}
					},
					{
						"type": "mutate",
						"new_name": "depreciation_pct",
						"data_type": "Decimal",
						"expression": {
							"type": "expression",
							"expression": "if_else(gross_purchase_amount > 0, accumulated_depreciation * 100 / gross_purchase_amount, 0)"
						}
					},
					{
						"type": "mutate",
						"new_name": "age_bucket",
						"data_type": "String",
						"expression": {
							"type": "expression",
							"expression": "cases((asset_age_years < 1, '1. Under 1 Year'), (asset_age_years < 3, '2. 1-3 Years'), (asset_age_years < 5, '3. 3-5 Years'), (asset_age_years < 10, '4. 5-10 Years'), else_='5. 10+ Years')"
						}
					},
					{
						"type": "select",
						"column_names": [
							"name",
							"asset_name",
							"item_code",
							"item_name",
							"asset_category",
							"asset_category_group",
							"company",
							"location",
							"branch",
							"custodian",
							"supplier",
							"status",
							"purchase_date",
							"available_for_use_date",
							"next_depreciation_date",
							"disposal_date",
							"gross_purchase_amount",
							"value_after_depreciation",
							"opening_accumulated_depreciation",
							"accumulated_depreciation",
							"depreciation_pct",
							"depreciation_method",
							"rate_of_depreciation",
							"depreciation_start_date",
							"total_number_of_depreciations",
							"frequency_of_depreciation",
							"useful_life",
							"is_existing_asset",
							"master_asset",
							"purchase_order",
							"purchase_receipt",
							"purchase_invoice",
							"asset_age_days",
							"asset_age_years",
							"age_bucket"
						]
					}
				]
			},
