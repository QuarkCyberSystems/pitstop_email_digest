  "queries": {
   "tq-gp-facts": {
    "name": "tq-gp-facts",
    "title": "Gross Profit Facts",
    "workbook": "template-erpnext-gross-profit",
    "folder": "tf-gp-queries",
    "sort_order": 0,
    "use_live_connection": 1,
    "is_script_query": 0,
    "is_builder_query": 0,
    "is_native_query": 1,
    "operations": [
     {
      "type": "sql",
      "data_source": "Site DB",
      "raw_sql": "with sle_rate as (\n    select\n        voucher_type,\n        voucher_detail_no,\n        case\n            when max(bundle_qty) then sum(stock_value_difference) / max(bundle_qty)\n            when sum(actual_qty)  then sum(stock_value_difference) / sum(actual_qty)\n            else 0\n        end as outgoing_rate\n    from `tabStock Ledger Entry`\n    where voucher_type in ('Sales Invoice', 'Delivery Note')\n    group by voucher_type, voucher_detail_no\n),\nsales_team as (\n    select parent, group_concat(distinct sales_person separator ', ') as sales_person\n    from `tabSales Team`\n    where parenttype = 'Sales Invoice'\n    group by parent\n),\nbundle_item as (\n    select distinct new_item_code from `tabProduct Bundle`\n),\nbase as (\n    select\n        si.name                                                        as invoice,\n        si_item.name                                                   as invoice_item,\n        si.posting_date,\n        si.company,\n        si.transaction_type,\n        coalesce(nullif(si.branch, ''), si_item.branch)                as branch,\n        coalesce(nullif(si.cost_center, ''), si_item.cost_center)      as cost_center,\n        coalesce(nullif(si_item.project, ''), si.project)              as project,\n        si.bill_to                                                     as customer,\n        si.bill_to_name                                                as customer_name,\n        c.customer_group,\n        si.territory,\n        st.sales_person,\n        si_item.item_code,\n        si_item.item_name,\n        i.item_group,\n        i.brand,\n        i.item_source,\n        case when i.is_stock_item = 1 or bi.new_item_code is not null\n             then 'Stock Item' else 'Non-Stock Item' end               as item_type,\n        coalesce(nullif(si.applies_to_variant_of, ''), si.applies_to_item) as vehicle_model,\n        si.applies_to_item                                             as vehicle_variant,\n        si_item.warehouse,\n        si_item.batch_no,\n        si_item.uom,\n        case when si.is_return = 1 then 'Return' else 'Sale' end       as entry_type,\n        si_item.qty,\n        si_item.stock_qty,\n        si_item.conversion_factor,\n        si_item.base_net_amount                                        as revenue,\n        -- the report's split: depreciation first, then the claim-customer share on top\n        (\n            case\n                when ifnull(si.depreciation_type, '') != '' and ifnull(si_item.ignore_depreciation, 0) = 0\n                then case\n                        when si.depreciation_type = 'After Depreciation Amount'\n                        then 100 - ifnull(si_item.depreciation_percentage, 0)\n                        else ifnull(si_item.depreciation_percentage, 0)\n                     end\n                else 100\n            end\n            *\n            case\n                when ifnull(dn_item.claim_customer, '') != ''\n                then case\n                        when dn_item.claim_customer != si.bill_to\n                        then ifnull(dn_item.discount_percentage, 0) / 100\n                        else 1 - ifnull(dn_item.discount_percentage, 0) / 100\n                     end\n                else 1\n            end\n        )                                                              as split_percentage,\n        -- unit cost: the stock ledger's own outgoing rate for this exact line\n        case\n            when i.is_stock_item != 1 and bi.new_item_code is null then 0\n            when si.update_stock = 1                                then ifnull(si_sle.outgoing_rate, 0)\n            when ifnull(si_item.delivery_note_item, '') != ''\n                 and (si.is_return = 0 or si.reopen_order = 1)      then ifnull(dn_sle.outgoing_rate, 0)\n            else 0\n        end                                                            as valuation_rate\n    from `tabSales Invoice` si\n    inner join `tabSales Invoice Item` si_item on si_item.parent = si.name\n    left  join `tabDelivery Note Item` dn_item on dn_item.name = si_item.delivery_note_item\n    left  join `tabCustomer` c                 on c.name = si.bill_to\n    left  join `tabItem` i                     on i.name = si_item.item_code\n    left  join bundle_item bi                  on bi.new_item_code = si_item.item_code\n    left  join sales_team st                   on st.parent = si.name\n    left  join sle_rate si_sle on si_sle.voucher_type = 'Sales Invoice' and si_sle.voucher_detail_no = si_item.name\n    left  join sle_rate dn_sle on dn_sle.voucher_type = 'Delivery Note'  and dn_sle.voucher_detail_no = si_item.delivery_note_item\n    where si.docstatus = 1\n      and si.is_opening != 'Yes'\n      and si.posting_date >= date_sub(curdate(), interval 24 month)\n)\nselect\n    base.*,\n    valuation_rate * conversion_factor * split_percentage / 100           as cogs_per_unit,\n    valuation_rate * conversion_factor * split_percentage / 100 * qty     as cogs,\n    revenue - (valuation_rate * conversion_factor * split_percentage / 100 * qty) as gross_profit\nfrom base\n"
     }
    ]
   }
  },
